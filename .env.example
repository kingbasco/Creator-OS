# Gemini Developer API key.
# Create it in Google AI Studio and keep it server-side only.
GEMINI_API_KEY=

# Cost-efficient default. Override only if you intentionally want another TTS model.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Temporary working voice until the audition is approved.
GEMINI_TTS_VOICE=Sulafat
